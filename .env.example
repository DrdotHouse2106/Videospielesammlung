# ─────────────────────────────────────────────────────────────
# Videospielesammlung – Konfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an:
#   cp .env.example .env
# Die .env-Datei wird NICHT ins Git-Repository übernommen.
# ─────────────────────────────────────────────────────────────

# Port, auf dem der Server lauscht (bei Docker: Port auf dem Host)
PORT=3000

# Pfad zur SQLite-Datenbank und zum Upload-Verzeichnis (relativ zum Projektordner oder absolut).
# Bei Docker werden diese Werte ignoriert – dort liegen die Daten im Volume /app/data.
DATABASE_PATH=data/sammlung.db
UPLOAD_DIR=data/uploads

# Maximale Größe hochgeladener Fotos in MB
MAX_UPLOAD_MB=8

# Wie lange Antworten externer Dienste zwischengespeichert werden (Stunden)
CACHE_TTL_HOURS=168

# ── IGDB (Spieldatenbank) über die Twitch-API ────────────────
# Kostenlos: https://dev.twitch.tv/console/apps → Anwendung registrieren
# (OAuth-Redirect-URL: http://localhost, Kategorie: „Application Integration“)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Barcode-Datenbanken (EAN/UPC → Produktname) ──────────────
# Kommagetrennte Reihenfolge der Dienste: opengtindb, upcitemdb
# Leer lassen, um nur lokal gelernte Barcodes zu verwenden.
BARCODE_PROVIDERS=opengtindb,upcitemdb
# Zugangsnummer für opengtindb.org (kostenlos, per E-Mail anfragen: https://opengtindb.org/api.php)
OPENGTINDB_QUERYID=

# ── Zugangsschutz (optional, im Internet dringend empfohlen) ─
# Sind beide Werte gesetzt, fragt der Browser nach Benutzername und Passwort.
AUTH_USER=
AUTH_PASSWORD=

# Hinter einem Reverse-Proxy (Caddy, Traefik, nginx) z. B. auf "1" setzen
TRUST_PROXY=
