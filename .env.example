# Hinweis: Viele dieser Werte können Administratoren auch unter Administration → Einstellungen ändern.
# Werte aus der Weboberfläche haben Vorrang; die .env bleibt die Grundeinstellung.

# ─────────────────────────────────────────────────────────────
# ZockDB – Konfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an:
#   cp .env.example .env
# Die .env-Datei wird NICHT ins Git-Repository übernommen.
# ─────────────────────────────────────────────────────────────

# Port, auf dem der Server lauscht (bei Docker: Port auf dem Host)
PORT=3000

# Pfad zur SQLite-Datenbank und zum Upload-Verzeichnis (relativ zum Projektordner oder absolut).
# Bei Docker werden diese Werte ignoriert – dort liegen die Daten im Volume /app/data.
DATABASE_PATH=data/sammlung.db
UPLOAD_DIR=data/uploads

# Maximale Größe hochgeladener Artikelfotos in MB
MAX_UPLOAD_MB=8
# Maximale Größe von Scans/Dokumenten (hochauflösende Cover, PDF-Handbücher) in MB
MEDIA_MAX_MB=200
# Dürfen Benutzer Scans mit allen angemeldeten Benutzern teilen? (true/false)
MEDIA_SHARING=true
# Speicherplatz je Benutzer für eigene Fotos und Scans in MB (0 = unbegrenzt).
# Freigegebene Scans zählen nicht mit; Administratoren können das Limit je Benutzer anpassen.
STORAGE_QUOTA_MB=1024

# Automatische Datenbank-Sicherung (Unterordner „sicherungen“ im Datenordner):
# die letzten BACKUP_DAYS Tage täglich, die letzten BACKUP_MONTHS Monate monatlich
BACKUP_ENABLED=true
BACKUP_DAYS=7
BACKUP_MONTHS=12

# Wie lange Antworten externer Dienste zwischengespeichert werden (Stunden)
CACHE_TTL_HOURS=168

# ── IGDB (Spieldatenbank) über die Twitch-API ────────────────
# Kostenlos: https://dev.twitch.tv/console/apps → Anwendung registrieren
# (OAuth-Redirect-URL: http://localhost, Kategorie: „Application Integration“)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Barcode-Datenbanken (EAN/UPC → Produktname) ──────────────
# Kommagetrennte Reihenfolge der Dienste: opengtindb, upcitemdb
# Leer lassen, um nur lokal gelernte Barcodes zu verwenden.
BARCODE_PROVIDERS=opengtindb,upcitemdb
# Zugangsnummer für opengtindb.org (kostenlos, per E-Mail anfragen: https://opengtindb.org/api.php)
OPENGTINDB_QUERYID=

# ── Benutzerkonten ───────────────────────────────────────────
# Das erste registrierte Konto wird automatisch Administrator.
# Dürfen sich neue Benutzer selbst registrieren? (true/false)
REGISTRATION_OPEN=true
# Maximale Anzahl Registrierungen pro IP-Adresse und Stunde (Schutz vor Spam)
REGISTRATIONS_PER_HOUR=5
# Zwei-Faktor-Anmeldung (Authenticator-App) für alle Benutzer verpflichtend? (true/false)
REQUIRE_2FA=false
# Wie lange eine Anmeldung gültig bleibt (Tage, verlängert sich bei Nutzung)
SESSION_DAYS=30
# Sitzungs-Cookie nur über HTTPS senden: auto (empfohlen, mit TRUST_PROXY), true oder false
COOKIE_SECURE=auto
# Geheimer Schlüssel zum Verschlüsseln der 2FA-Geheimnisse (lange Zufallszeichenkette).
# Leer lassen = wird automatisch erzeugt und als data/geheimnis.key gespeichert.
# Erzeugen z. B. mit: openssl rand -base64 32
APP_SECRET=

# ── E-Mail (SMTP) ─────────────────────────────────────────────
# Für „Passwort vergessen“, Bestätigung der E-Mail-Adresse und Benachrichtigungen.
# Links in E-Mails werden nur mit PUBLIC_URL erzeugt.
SMTP_HOST=
SMTP_PORT=587
# auto (465 = TLS, sonst STARTTLS), true oder false
SMTP_SECURE=auto
SMTP_USER=
SMTP_PASSWORD=
# z. B. ZockDB <noreply@example.de>
SMTP_FROM=
# Spam-Schutz für Registrierung und „Passwort vergessen“:
#   altcha    – Rechenaufgabe im Browser, ohne Cookies und ohne Dritte (Standard)
#   recaptcha – Google reCAPTCHA v3 (Daten an Google/USA, wird erst nach Einwilligung geladen)
#   aus
CAPTCHA_PROVIDER=altcha
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# E-Mail-Adresse bei der Registrierung verpflichtend?
REQUIRE_EMAIL=false

# ── Öffentliche Seiten ───────────────────────────────────────
# Startseite, Suche und Spieleseiten auch ohne Anmeldung zeigen (false = alles nur nach Anmeldung).
# Sammlungen, Kommentare und Scans bleiben immer hinter der Anmeldung.
PUBLIC_CATALOG=true
# Öffentliche Adresse der Seite ohne / am Ende (nötig für Links in E-Mails)
# PUBLIC_URL=https://sammlung.example.de

# Links zu externen Cover-/Handbuch-Seiten optional auf bestimmte Domains beschränken
# (kommagetrennt, Subdomains inklusive), z. B.: LINK_DOMAINS=nintendo.de,sega.com,archive.org
LINK_DOMAINS=

# „Hier kaufen“-Links auf Katalogseiten ausblenden:
# AFFILIATE_LINKS=false

# ── Tauschbörse (Suche/Biete, ohne Zahlungsabwicklung) ───────
MARKET_ENABLED=true
# Laufzeit eines Angebots (Tage) und kostenlose aktive Angebote je Benutzer (auch per CSV-Upload)
MARKET_OFFER_DAYS=90
MARKET_MAX_OFFERS=50
# Händler-Pakete (Anzahl aktiver Angebote = Monatspreis in €) und Zusatzpaket API-Anbindung (€/Monat)
MARKET_PACKAGES=500=9,90;1000=14,90;5000=29,90
MARKET_API_PRICE=19,90
# Kostenloser Test, den verifizierte Händler einmal selbst starten können (Tage, 0 = nur durch Administratoren)
MARKET_TRIAL_DAYS=0
# Neue Konten ohne bestätigte E-Mail dürfen erst nach X Tagen Nachrichten schreiben
MARKET_MIN_ACCOUNT_DAYS=3
# Kontakt für Buchungen und individuelle Anbindungen (E-Mail oder https-Adresse) und Zusatzhinweis, z. B. zzgl. MwSt.
MARKET_PRO_CONTACT=
MARKET_PRO_INFO=

# ── Zahlungen (optional): Händler buchen Pakete selbst ───────
# Webhooks: PUBLIC_URL + /api/zahlung/stripe/webhook bzw. /api/zahlung/paypal/webhook
PAYMENT_VAT_RATE=19
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_PAYPAL_CLIENT_ID=
PAYMENT_PAYPAL_SECRET=
PAYMENT_PAYPAL_WEBHOOK_ID=
PAYMENT_PAYPAL_MODE=live
PAYMENT_PAYPAL_FEE=1,00

# ── Rechnungen in ERPNext (optional) ─────────────────────────
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=
ERPNEXT_ITEM_CODE=ZOCKDB-ABO
ERPNEXT_TAX_TEMPLATE=
ERPNEXT_ACCOUNT_STRIPE=
ERPNEXT_ACCOUNT_PAYPAL=

# ── Automatischer Preisimport ────────────────────────────────
# Aktuelle Angebote über die offizielle eBay Browse API (kostenlos: https://developer.ebay.com
# → „Application Keys“ → Production).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marktplatz und Artikelstandort (Standard: eBay.de, Deutschland)
EBAY_MARKETPLACE=EBAY_DE
EBAY_ITEM_LOCATION=DE
# Import alle X Stunden (0 = aus)
PRICE_IMPORT_HOURS=24

# ── Marktpreise (optional) ───────────────────────────────────
# API-Token von https://www.pricecharting.com (kostenpflichtiges Abo mit API-Zugang).
# Ohne Token gibt es eigene Schätzungen und anonyme Community-Werte.
PRICECHARTING_TOKEN=
# Fester Umrechnungskurs USD → EUR (leer = Tageskurs der Europäischen Zentralbank)
USD_EUR_RATE=
# Wie lange abgerufene Marktpreise gültig bleiben (Stunden)
PRICE_CACHE_HOURS=72

# Hinter einem Reverse-Proxy (Caddy, Traefik, nginx) auf "1" setzen – wichtig für
# sichere Cookies und die Begrenzung von Anmeldeversuchen pro IP-Adresse.
TRUST_PROXY=
