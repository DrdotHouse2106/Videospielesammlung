# ─────────────────────────────────────────────────────────────
# Videospielesammlung – Konfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an:
#   cp .env.example .env
# Die .env-Datei wird NICHT ins Git-Repository übernommen.
# ─────────────────────────────────────────────────────────────

# Port, auf dem der Server lauscht (bei Docker: Port auf dem Host)
PORT=3000

# Pfad zur SQLite-Datenbank und zum Upload-Verzeichnis (relativ zum Projektordner oder absolut).
# Bei Docker werden diese Werte ignoriert – dort liegen die Daten im Volume /app/data.
DATABASE_PATH=data/sammlung.db
UPLOAD_DIR=data/uploads

# Maximale Größe hochgeladener Artikelfotos in MB
MAX_UPLOAD_MB=8
# Maximale Größe von Scans/Dokumenten (hochauflösende Cover, PDF-Handbücher) in MB
MEDIA_MAX_MB=200
# Dürfen Benutzer Scans mit allen angemeldeten Benutzern teilen? (true/false)
MEDIA_SHARING=true

# Wie lange Antworten externer Dienste zwischengespeichert werden (Stunden)
CACHE_TTL_HOURS=168

# ── IGDB (Spieldatenbank) über die Twitch-API ────────────────
# Kostenlos: https://dev.twitch.tv/console/apps → Anwendung registrieren
# (OAuth-Redirect-URL: http://localhost, Kategorie: „Application Integration“)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Barcode-Datenbanken (EAN/UPC → Produktname) ──────────────
# Kommagetrennte Reihenfolge der Dienste: opengtindb, upcitemdb
# Leer lassen, um nur lokal gelernte Barcodes zu verwenden.
BARCODE_PROVIDERS=opengtindb,upcitemdb
# Zugangsnummer für opengtindb.org (kostenlos, per E-Mail anfragen: https://opengtindb.org/api.php)
OPENGTINDB_QUERYID=

# ── Benutzerkonten ───────────────────────────────────────────
# Das erste registrierte Konto wird automatisch Administrator.
# Dürfen sich neue Benutzer selbst registrieren? (true/false)
REGISTRATION_OPEN=true
# Maximale Anzahl Registrierungen pro IP-Adresse und Stunde (Schutz vor Spam)
REGISTRATIONS_PER_HOUR=5
# Zwei-Faktor-Anmeldung (Authenticator-App) für alle Benutzer verpflichtend? (true/false)
REQUIRE_2FA=false
# Wie lange eine Anmeldung gültig bleibt (Tage, verlängert sich bei Nutzung)
SESSION_DAYS=30
# Sitzungs-Cookie nur über HTTPS senden: auto (empfohlen, mit TRUST_PROXY), true oder false
COOKIE_SECURE=auto
# Geheimer Schlüssel zum Verschlüsseln der 2FA-Geheimnisse (lange Zufallszeichenkette).
# Leer lassen = wird automatisch erzeugt und als data/geheimnis.key gespeichert.
# Erzeugen z. B. mit: openssl rand -base64 32
APP_SECRET=

# ── Öffentlicher Katalog ─────────────────────────────────────
# Katalogseiten (Spiele, Varianten, Preisverlauf, Kauflinks) auch ohne Anmeldung zeigen.
# Sammlungen, Kommentare und Scans bleiben immer hinter der Anmeldung.
PUBLIC_CATALOG=true

# ── Affiliate-/Partnerlinks („Hier kaufen“) ─────────────────
# Standardwerte stehen in server/affiliate-konfiguration.js. Hier nur überschreiben,
# wenn du eigene Partner-IDs verwenden oder die Links abschalten möchtest.
# AFFILIATE_LINKS=false
# AFFILIATE_AMAZON_TAG=
# AFFILIATE_EBAY_CAMPID=

# ── Marktpreise (optional) ───────────────────────────────────
# API-Token von https://www.pricecharting.com (kostenpflichtiges Abo mit API-Zugang).
# Ohne Token gibt es eigene Schätzungen und anonyme Community-Werte.
PRICECHARTING_TOKEN=
# Fester Umrechnungskurs USD → EUR (leer = Tageskurs der Europäischen Zentralbank)
USD_EUR_RATE=
# Wie lange abgerufene Marktpreise gültig bleiben (Stunden)
PRICE_CACHE_HOURS=72

# Hinter einem Reverse-Proxy (Caddy, Traefik, nginx) auf "1" setzen – wichtig für
# sichere Cookies und die Begrenzung von Anmeldeversuchen pro IP-Adresse.
TRUST_PROXY=
